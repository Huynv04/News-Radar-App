# Cấu hình Môi trường Triển khai Production cho News Radar
# Đổi tên file này thành .env trước khi chạy docker compose

# Mật khẩu PostgreSQL (Bắt buộc đổi khi lên Production thật), lấy cái gì cũng đc
DB_PASSWORD=admin123@

# Khóa bí mật JWT Bearer Token (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=NewsRadar_SuperSecretKey_ChangeInProduction_Min32Chars!

# Google OAuth Client ID (Nếu có)
GOOGLE_CLIENT_ID=850860900750-rdjeovm4lprvbtrgk7g3is2u8e3cgjge.apps.googleusercontent.com

# GitHub OAuth Client ID & Secret (Nếu có)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

